<?xml version="1.0"?>
<mujoco xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="add_robot" params="robot_name robot_pos robot_rot">

    <xacro:include filename="$(find tiago_mujoco)/assets/xacro/tiago.mujoco.xacro" />
    <xacro:include filename="$(find tiago_mujoco)/assets/xacro/assets.mujoco.xacro" />

    <xacro:pmb2_assets />
    <xacro:tiago_assets />

    <worldbody>
      <xacro:tiago_robot name="${robot_name}" pos="${robot_pos}" rot="${robot_rot}" />
    </worldbody>

    <xacro:pmb2_contacts name="${robot_name}" />
    <xacro:pmb2_sensors name="${robot_name}" />
    <sensor>
      <force name="left_fingertip" site="gripper_finger_l_site" />
      <force name="right_fingertip" site="gripper_finger_r_site" />
    </sensor>

    <!-- Query the Xacro launch argument directly, rather than relying on the
         end_effector property from a nested tiago_robot macro include. -->
    <xacro:property name="cupro_ee_type" value="$(arg end_effector)"/>

    <!-- These constraints and exclusions only apply to the CuPro variants.
         The WSG/CuPro bodies and joints are already created by tiago_robot. -->
    <xacro:if value="${cupro_ee_type in ['schunk-wsg-cupro', 'schunk-wsg-cupro-4']}">
      <!-- Finger arrangement follows the existing end_effector selection:
           schunk-wsg-cupro: 1 left + 2 right
           schunk-wsg-cupro-4: 2 left + 2 right.
           Do not depend on global counts exported from nested gripper macros. -->
      <xacro:property name="cupro_fingers_left" value="${2 if cupro_ee_type == 'schunk-wsg-cupro-4' else 1}"/>
      <xacro:property name="cupro_fingers_right" value="2"/>
      <contact>
        <!-- Sliding finger bodies -->
        <exclude body1="gripper_left_finger_link" body2="gripper_right_finger_link" />

        <!-- Opposing finger bodies -->
        <exclude body1="gripper_finger_l_1" body2="gripper_finger_r_1" />
        <exclude body1="gripper_finger_l_1" body2="gripper_finger_r_2" />

        <!-- Finger and opposing mounting plate -->
        <exclude body1="gripper_finger_l_1" body2="gripper_finger_mount_r" />
        <exclude body1="gripper_finger_mount_l" body2="gripper_finger_r_1" />
        <exclude body1="gripper_finger_mount_l" body2="gripper_finger_r_2" />

        <!-- Opposing mounting plates -->
        <exclude body1="gripper_finger_mount_l" body2="gripper_finger_mount_r" />

        <!-- Robot-specific collision exclusion -->
        <exclude body1="gripper_link" body2="arm_5_link" />
      </contact>

      <!-- ROS mimic joint and existing nonlinear mount-folding behavior. -->
      <equality>
        <joint name="gripper_slider_synchronization"
               joint1="gripper_right_finger_joint"
               joint2="gripper_finger_joint"
               polycoef="0 1 0 0 0" />

        <joint name="gripper_left_mount_coupling"
               joint1="gripper_finger_mount_l_joint"
               joint2="gripper_finger_joint"
               polycoef="0 16.8 -490 14000 0" />

        <joint name="gripper_right_mount_coupling"
               joint1="gripper_finger_mount_r_joint"
               joint2="gripper_right_finger_joint"
               polycoef="0 16.8 -490 14000 0" />
      </equality>

      <!-- Only articulated CuPro has curl hinges and tendons.
           This include supplies the macro; it does not create finger bodies. -->
      <xacro:if value="$(arg use_curl_tendons)">
        <xacro:include filename="$(find cupro_gripper_description)/mujoco/cupro_tendon_gripper.xml.xacro" />
        <tendon>
          <xacro:cupro_curl_tendons
              name="gripper" side="l" num_finger="${cupro_fingers_left}" />
          <xacro:cupro_curl_tendons
              name="gripper" side="r" num_finger="${cupro_fingers_right}" />
        </tendon>
      </xacro:if>
    </xacro:if>

  </xacro:macro>
</mujoco>
